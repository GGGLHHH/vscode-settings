// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "auto_install_extensions": {
    "vue": true,
    "oxc": true,
    "unocss": true,
    "vitesse": true,
    "mdx": true,
    "catppuccin-icons": true,
    "one-dark-pro": true,
    "live-server": true,
    "html": true,
    "git-firefly": true,
    "golangci-lint": true
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "close_on_file_delete": true,
  "project_panel": {
    "indent_size": 10
  },
  "lsp": {
    "eslint": {
      "settings": {
        // 静音 antfu 风格类规则（保存时仍会自动修复），同 VS Code eslint.rules.customizations
        "quiet": true,
        "rulesCustomizations": [
          { "rule": "style/*", "severity": "off" },
          { "rule": "format/*", "severity": "off" },
          { "rule": "*-indent", "severity": "off" },
          { "rule": "*-spacing", "severity": "off" },
          { "rule": "*-spaces", "severity": "off" },
          { "rule": "*-order", "severity": "off" },
          { "rule": "*-dangle", "severity": "off" },
          { "rule": "*-newline", "severity": "off" },
          { "rule": "*quotes", "severity": "off" },
          { "rule": "*semi", "severity": "off" }
        ]
      }
    },
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": ["class", "className", "ngClass", "class:list", "tableClass"],
        "classFunctions": ["cn"]
      }
    },
    "pyright": {
      "settings": {
        "python": {
          "analysis": {
            "typeCheckingMode": "strict"
          }
        }
      }
    },
    "gopls": {
      "initialization_options": {
        "semanticTokens": true
      }
    }
  },
  "languages": {
    "JavaScript": {
      "format_on_save": "on",
      "formatter": { "code_action": "source.fixAll.eslint" }
    },
    "TypeScript": {
      "format_on_save": "on",
      "formatter": { "code_action": "source.fixAll.eslint" }
    },
    "TSX": {
      "format_on_save": "on",
      "formatter": { "code_action": "source.fixAll.eslint" }
    },
    "Vue.js": {
      "format_on_save": "on",
      "formatter": { "code_action": "source.fixAll.eslint" }
    }
  },
  "icon_theme": "Catppuccin Mocha",
  "terminal": {
    "shell": {
      "program": "/opt/homebrew/bin/fish"
    },
    "font_size": 12.0,
    "font_family": "JetBrainsMonoNL Nerd Font Mono",
    "cursor_shape": "bar",
    "blinking": "on",
    "max_scroll_history_lines": 10000
  },
  "git": {
    "inline_blame": {
      "enabled": true
    }
  },
  "preview_tabs": {
    "enabled": false
  },
  "tabs": {
    "close_position": "right"
  },
  "lsp_document_links": false,
  "multi_cursor_modifier": "alt",
  "sticky_scroll": {
    "enabled": true
  },
  "minimap": {
    "show": "always"
  },
  "hover_popover_sticky": true,
  "use_system_window_tabs": true,
  "max_tabs": 5,
  "use_system_path_prompts": true,
  "buffer_font_family": "JetBrainsMonoNL Nerd Font",
  "file_types": {
    "ignore": [
      "*ignore"
    ]
  },
  "show_whitespaces": "boundary",
  "show_edit_predictions": true,
  "line_ending": "prefer_lf",
  "ensure_final_newline_on_save": true,
  "tab_size": 2,
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "Vitesse Light",
    "dark": "One Dark Pro",
  },
}
