{
  "Solid Component": {
    "prefix": "solid",
    "body": [
      "interface I${1/(.*)/${1:/capitalize}/}Props {",
      "  $2",
      "}",
      "",
      "export const ${1/(.*)/${1:/capitalize}/} = (props: I${1/(.*)/${1:/capitalize}/}Props) => {",
      "  return (",
      "    <div>",
      "      $0",
      "    </div>",
      "  );",
      "};"
    ],
    "description": "创建一个新的 SolidJS 组件"
  },
  "Solid Signal": {
    "prefix": "sg",
    "body": [
      "const [${1:state}, set${1/(.*)/${1:/capitalize}/}] = createSignal(${2:initialValue});"
    ],
    "description": "创建一个 SolidJS Signal"
  },
  "Solid Effect": {
    "prefix": "effect",
    "body": [
      "createEffect(() => {",
      "  $0",
      "});"
    ],
    "description": "创建一个 SolidJS Effect"
  },
  "Solid Memo": {
    "prefix": "memo",
    "body": [
      "const ${1:memoized} = createMemo(() => {",
      "  return $0;",
      "});"
    ],
    "description": "创建一个 SolidJS Memo"
  },
  "Solid For": {
    "prefix": "for",
    "body": [
      "<For each={${1:items}}>",
      "  {(item) => (",
      "    <div>",
      "      $0",
      "    </div>",
      "  )}",
      "</For>"
    ],
    "description": "创建一个 SolidJS For 循环"
  },
  "Solid Show": {
    "prefix": "show",
    "body": [
      "<Show when={${1:condition}} fallback={<div>${2:fallback}</div>}>",
      "  $0",
      "</Show>"
    ],
    "description": "创建一个 SolidJS 条件渲染"
  },
  "Solid Resource": {
    "prefix": "resource",
    "body": [
      "const [${1:data}] = createResource(${2:source}, async (${3:source}) => {",
      "  $0",
      "});"
    ],
    "description": "创建一个 SolidJS Resource"
  },
  "Solid Store": {
    "prefix": "store",
    "body": [
      "const [${1:store}, set${1/(.*)/${1:/capitalize}/}] = createStore(${2:initialState});"
    ],
    "description": "创建一个 SolidJS Store"
  },
  "Arrow Function": {
    "prefix": "arrow",
    "body": [
      "const ${1:functionName} = (${2:params}) => {",
      "  $0",
      "};"
    ],
    "description": "创建一个箭头函数"
  },
  "Arrow Function with Return": {
    "prefix": "arrowr",
    "body": [
      "const ${1:functionName} = (${2:params}) => (",
      "  $0",
      ");"
    ],
    "description": "创建一个带返回值的箭头函数"
  },
  "Arrow Function with Type": {
    "prefix": "arrowt",
    "body": [
      "const ${1:functionName} = (${2:params}: ${3:type}): ${4:returnType} => {",
      "  $0",
      "};"
    ],
    "description": "创建一个带类型的箭头函数"
  },
  "Arrow Function Async": {
    "prefix": "arrowa",
    "body": [
      "const ${1:functionName} = async (${2:params}) => {",
      "  $0",
      "};"
    ],
    "description": "创建一个异步箭头函数"
  },
  "Arrow Function with Props": {
    "prefix": "arrowp",
    "body": [
      "const ${1:functionName} = ({ ${2:prop1}, ${3:prop2} }: ${4:PropsType}) => {",
      "  $0",
      "};"
    ],
    "description": "创建一个带解构参数的箭头函数"
  }
} 
