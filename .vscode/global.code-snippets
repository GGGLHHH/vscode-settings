{
  "import": {
    "prefix": "imp",
    "body": [
      "import { $2 } from '$1';"
    ],
    "description": "Import a module"
  },
  "export-all": {
    "prefix": "exp",
    "body": [
      "export * from '$2';"
    ],
    "description": "Export a module"
  },
  "console-log": {
    "prefix": "cl",
    "body": [
      "console.log('$2');"
    ],
    "description": "Log a message to the console"
  }
}
